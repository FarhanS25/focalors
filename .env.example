# Copy this file to backend/.env and replace the placeholders.
# Do not commit backend/.env or the repository-root .env.
# Do not put a real password in this example file.
# If the password contains @ : / ? # [ ] or %, URL-encode it before pasting.
# MONGODB_DATABASE is the database name. It does not have to appear in the URI path.
# The collection name is simulation_runs unless MONGODB_COLLECTION overrides it.

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=focalors
MONGODB_COLLECTION=simulation_runs

# Optional. Comma-separated browser origins when the website is not served
# from the same host as the API. Do not use *.
# CORS_ORIGINS=http://ec2-public-dns.compute.amazonaws.com
